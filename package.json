                         "@fastify/multipart":  "^8.3.1",
                         "@fastify/static":  "^7.0.4",
                         "@fastify/swagger":  "^8.14.0",
                         "@fastify/swagger-ui":  "^3.0.0",
                         "@fastify/websocket":  "^8.3.1",
                         "@libsql/client":  "^0.14.0",
                         "adm-zip":  "^0.6.0",
                         "dotenv":  "^16.4.5",
                         "drizzle-orm":  "^0.30.2",
                         "fastify":  "^4.26.2",
                         "imap-simple":  "^5.1.0",
                         "mail-parser-ts":  "^1.0.1",
                         "mailparser":  "^3.7.1",
                         "playwright":  "^1.42.1",
                         "ssh2":  "^1.17.0"
                     },
    "devDependencies":  {
                            "@types/adm-zip":  "^0.5.8",
