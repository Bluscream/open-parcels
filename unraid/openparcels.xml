<?xml version="1.0"?>
<Container version="2">
  <Name>OpenParcels</Name>
  <Repository>openparcels/openparcels:latest</Repository>
  <Registry>https://hub.docker.com/r/openparcels/openparcels</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/openparcels/openparcels/issues</Support>
  <Project>https://github.com/openparcels/openparcels</Project>
  <Overview>Self-hostable service that ingests and tracks parcels, returns and orders from multiple sources.</Overview>
  <Category>Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:3000]</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/openparcels/openparcels/main/icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1716768000</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Port" Target="3000" Default="3000" Mode="tcp" Type="Port" Display="always" Required="true">3000</Config>
  <Config Name="Data Path" Target="/data" Default="/mnt/user/appdata/openparcels" Mode="rw" Type="Path" Display="always" Required="true">/mnt/user/appdata/openparcels</Config>
  <Config Name="Encryption Key" Target="ENCRYPTION_KEY" Default="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" Type="Variable" Display="always" Required="true" Mask="true">07D3FCEF02FD0EFCDF3A3AE64EE8D6C1073F7C572B856C04BF8D3B6A24B9E4B7</Config>
  <Config Name="Admin Token" Target="OPENPARCELS_TOKEN" Default="admin_secret_token" Type="Variable" Display="always" Required="true" Mask="true">ebdc8408-7685-4584-9726-bf4a7175fb90</Config>
  <Config Name="Database Path" Target="DB_PATH" Default="/data/data.db" Type="Variable" Display="advanced" Required="false">/data/data.db</Config>
  <Config Name="Rules URLs" Target="OPENPARCELS_RULES" Default="https://github.com/Bluscream/email-parser-rules/releases/latest/download/parcel.js,https://github.com/Bluscream/email-parser-rules/releases/latest/download/order.js,https://github.com/Bluscream/email-parser-rules/releases/latest/download/return.js" Type="Variable" Display="advanced" Required="false">https://github.com/Bluscream/email-parser-rules/releases/latest/download/parcel.js,https://github.com/Bluscream/email-parser-rules/releases/latest/download/order.js,https://github.com/Bluscream/email-parser-rules/releases/latest/download/return.js</Config>
  <Config Name="Lookup URLs" Target="LOOKUP_URLS" Default="http://localhost:24011,http://host.containers.internal:24011,https://lookup.tail230321.ts.net,https://lookup.minopia.de" Type="Variable" Display="advanced" Required="false">http://localhost:24011,http://host.containers.internal:24011,https://lookup.tail230321.ts.net,https://lookup.minopia.de</Config>
  <Config Name="Queue Interval" Target="OPENPARCELS_QUEUE_INTERVAL" Default="10" Type="Variable" Display="advanced" Required="false">10</Config>
  <Config Name="HA URL" Target="HASS_URL" Default="http://homeassistant.local:8123" Type="Variable" Display="advanced" Required="false" />
  <Config Name="HA Token" Target="HASS_TOKEN" Default="" Type="Variable" Display="advanced" Required="false" Mask="true" />
</Container>