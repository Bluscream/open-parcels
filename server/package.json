{
  "name": "@open-parcels/server",
  "version": "2.0.0-dev.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "tsc -p tsconfig.build.json && node dist/tools/export-openapi.js ../docs/openapi.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.11",
    "@fastify/swagger": "9.9.5",
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "ical-generator": "11.1.3",
    "imapflow": "2.12.1",
    "kysely": "0.29.9",
    "mailparser": "3.14.5",
    "open-parcels-rules": "file:vendor/open-parcels-rules-2.0.0-dev.4.tgz",
    "pino": "10.4.0",
    "tough-cookie": "6.1.0",
    "undici": "8.12.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
