{
  "name": "@open-parcels/server",
  "version": "2.0.0-dev.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
